{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "preferredVersions": {
        "php": "latest",
        "wp": "latest"
    },
    "login": true,
    "landingPage": "/",
    "features": {
        "networking": true
    },
    "siteOptions": {
        "blogname": "Stellux Gallery - Demo",
        "blogdescription": "Everyday Elegance, Timeless Shine",
        "permalink_structure": "/%postname%/",
        "show_on_front": "page",
        "page_on_front": "1300",
        "page_for_posts": "1177"
    },
    "steps": [
        {
            "step": "wp-cli",
            "command": "wp site empty --yes"
        },
        {
            "step": "installTheme",
            "themeZipFile": {
                "resource": "url",
                "url": "https://raw.githubusercontent.com/ehsanmoattari/stellux-gallery/main/kadence.zip"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "wordpress.org/plugins",
                "slug": "woocommerce"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "wordpress.org/plugins",
                "slug": "kadence-blocks"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "importWxr",
            "file": {
                "resource": "url",
                "url": "https://raw.githubusercontent.com/ehsanmoattari/stellux-gallery/main/content.xml"
            }
        },
        {
            "step": "setSiteOptions",
            "options": {
                "show_on_front": "page",
                "page_on_front": "1300",
                "page_for_posts": "1177"
            }
        }
    ]
}
